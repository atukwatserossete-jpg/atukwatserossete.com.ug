/* ROSSETTE COMPUTER SOLUTIONS - shared website styles */
* {
  box-sizing: border-box;
}

body {
  margin: 0;
  font-family: Arial, Helvetica, sans-serif;
  line-height: 1.6;
  color: #243247;
  background: #f2f6fb;
  text-align: center;
}

header {
  background: #123b66;
  color: white;
  padding: 32px 16px;
}

header h1 {
  margin: 0;
  letter-spacing: 2px;
}

header p {
  margin: 8px 0 0;
  font-weight: bold;
  letter-spacing: 1px;
}

nav {
  background: #092746;
  padding: 14px 8px;
  display: flex;
  justify-content: center;
  flex-wrap: wrap;
  gap: 10px 24px;
}

nav a {
  color: white;
  text-decoration: none;
  font-weight: bold;
}

nav a:hover {
  color: #8bd3ff;
  text-decoration: underline;
}

main {
  width: min(100% - 32px, 1000px);
  margin: 30px auto;
  padding: 28px 20px;
  background: white;
  border-radius: 12px;
  box-shadow: 0 4px 16px rgba(15, 45, 75, 0.08);
}

h2 {
  color: #123b66;
  margin-top: 0;
}

.hero {
  padding: 30px 12px;
  background: #e7f2fc;
  border-radius: 10px;
  margin-bottom: 26px;
}

.button, button {
  display: inline-block;
  border: 0;
  border-radius: 6px;
  padding: 12px 22px;
  background: #0878bd;
  color: white;
  text-decoration: none;
  font-size: 16px;
  font-weight: bold;
  cursor: pointer;
}

.button:hover, button:hover {
  background: #075b91;
}

.cards {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: 18px;
  margin-top: 24px;
}

.card {
  padding: 20px;
  background: #f1f7fc;
  border: 1px solid #d8e7f4;
  border-radius: 10px;
}

.card h3 {
  color: #0878bd;
  margin-top: 0;
}

form {
  max-width: 600px;
  margin: 24px auto;
  display: flex;
  flex-direction: column;
  align-items: stretch;
  gap: 10px;
  text-align: left;
}

form label {
  font-weight: bold;
}

input, textarea {
  width: 100%;
  padding: 12px;
  border: 1px solid #b9c9d8;
  border-radius: 6px;
  font: inherit;
}

form button {
  align-self: center;
  margin-top: 8px;
}

.note {
  font-size: 0.9rem;
  color: #526579;
}

footer {
  margin-top: 30px;
  padding: 18px;
  background: #092746;
  color: white;
  font-weight: bold;
}

footer p {
  margin: 0;
}

@media (max-width: 600px) {
  header h1 {
    font-size: 1.5rem;
  }

  nav {
    gap: 10px 14px;
  }

  main {
    padding: 22px 14px;
  }
}
