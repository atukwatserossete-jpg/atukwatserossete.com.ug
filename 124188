      <textarea id="message" name="Message" rows="6" placeholder="Write your message here..." required></textarea>
      <button type="submit">Send Message</button>
    </form>
    <p class="note">To receive messages, replace <strong>your-email@example.com</strong> in this file with your email address. The mailto form opens the visitor's email application.</p>
